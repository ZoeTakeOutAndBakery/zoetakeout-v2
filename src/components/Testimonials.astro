---
const { testimonials } = Astro.props;
---
<section class="py-16 bg-section-bg">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-3">What Customers Say</h2>
      <p class="text-muted-foreground text-lg">Real words from our community.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {(testimonials || []).map((testimonial) => (
        <article class="rounded-2xl border border-border bg-background shadow-[var(--card-shadow)] p-6">
          <p class="text-foreground leading-relaxed">"{testimonial.quote}"</p>
          <p class="mt-4 text-sm font-semibold text-primary">— {testimonial.author}</p>
        </article>
      ))}
    </div>
  </div>
</section>
