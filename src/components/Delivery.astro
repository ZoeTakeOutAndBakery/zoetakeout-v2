---
const { links } = Astro.props;
---
<section class="py-16 bg-background">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-3">Order Delivery</h2>
      <p class="text-muted-foreground text-lg">Find us on your favorite delivery platforms.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 max-w-3xl mx-auto">
      {(links || []).map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer"
          class="group rounded-2xl border border-border bg-warm-white shadow-[var(--card-shadow)] p-6 flex items-center gap-4 transition-transform hover:-translate-y-1"
        >
          {link.logo?.asset?.url ? (
            <img
              src={link.logo.asset.url}
              alt={link.logo.alt || link.label}
              class="w-12 h-12 object-contain"
              loading="lazy"
            />
          ) : null}
          <div>
            <p class="text-lg font-semibold text-primary">{link.label}</p>
            <p class="text-sm text-muted-foreground">Order online</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
