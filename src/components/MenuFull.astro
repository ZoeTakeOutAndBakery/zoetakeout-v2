---
const { categories } = Astro.props;
---
<section class="py-16 bg-background">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">Our Menu</h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Freshly prepared favorites made daily.
      </p>
    </div>

    <div class="space-y-12">
      {(categories || []).map((category) => (
        <section class="rounded-2xl border border-border bg-warm-white shadow-[var(--card-shadow)] overflow-hidden">
          <div class="grid md:grid-cols-[240px_1fr]">
            {category.image?.asset?.url ? (
              <img
                src={category.image.asset.url}
                alt={category.image.alt || category.title}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="bg-secondary h-full w-full min-h-[200px]"></div>
            )}
            <div class="p-6 md:p-8">
              <h2 class="text-2xl font-semibold text-primary">{category.title}</h2>
              {category.description ? (
                <p class="text-muted-foreground mt-2">{category.description}</p>
              ) : null}

              <div class="mt-6 grid gap-6 md:grid-cols-2">
                {(category.items || []).map((item) => (
                  <div class="space-y-2 border-b border-border pb-4 last:border-b-0 last:pb-0">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="font-semibold text-foreground">{item.name}</h3>
                        {item.description ? (
                          <p class="text-sm text-muted-foreground">{item.description}</p>
                        ) : null}
                      </div>
                      {item.price ? (
                        <span class="text-sm font-semibold text-primary">{item.price}</span>
                      ) : null}
                    </div>
                    {item.tags?.length ? (
                      <div class="flex flex-wrap gap-2">
                        {item.tags.map((tag) => (
                          <span class="text-xs font-medium px-2 py-1 rounded-full bg-secondary text-secondary-foreground">
                            {tag}
                          </span>
                        ))}
                      </div>
                    ) : null}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
