---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Hours from "../components/Hours.astro";
import MenuPreview from "../components/MenuPreview.astro";
import Reservations from "../components/Reservations.astro";
import Delivery from "../components/Delivery.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getSiteSettings, getHours, getMenuCategories, getTestimonials, getDeliveryLinks } from "../lib/sanity";

const [siteSettings, hours, menuCategories, testimonials, deliveryLinks] = await Promise.all([
  getSiteSettings(),
  getHours(),
  getMenuCategories(),
  getTestimonials(),
  getDeliveryLinks(),
]);

const doorDashLink = (deliveryLinks || []).find((link) =>
  String(link.label || "").toLowerCase().includes("doordash")
);

const orderUrl = doorDashLink?.url ||
  "https://www.doordash.com/store/zoe-take-out-&-bakery-fort-lauderdale-35400527/?srsltid=AfmBOoqkIgFsB18ggUrqkBHTGTtmiZQ7yD-fyjLuO50RVwfhWWrJvvuG";

const heroCta = {
  text: siteSettings?.primaryCtaText,
  url: siteSettings?.primaryCtaUrl,
};
const secondaryCta = {
  text: siteSettings?.secondaryCtaText,
  url: siteSettings?.secondaryCtaUrl,
};
---
<BaseLayout
  title={siteSettings?.title || "Zoe Take Out & Bakery"}
  description={siteSettings?.description}
  canonical={Astro.url}
>
  <Header orderUrl={orderUrl} />
  <main>
    <Hero
      heading={siteSettings?.heroHeading}
      subhead={siteSettings?.heroSubhead}
      primaryCta={heroCta}
      secondaryCta={secondaryCta}
    />
    <Hours hours={hours} />
    <MenuPreview categories={menuCategories} />
    <Reservations contactPhone={siteSettings?.contactPhone} />
    <Delivery links={deliveryLinks} />
    <Testimonials testimonials={testimonials} />
    <Contact contact={siteSettings} />
  </main>
  <Footer siteTitle={siteSettings?.title} />
</BaseLayout>
